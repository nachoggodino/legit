# ---------------------------------------------------------------------------
# New Next.js web app - Phase 2/3 placeholders
# ---------------------------------------------------------------------------
# Copy the values you need into web/.env.local for local development, or provide
# them through Docker/Kubernetes secrets in deployment.

AUTH_SECRET=replace-with-random-auth-secret
AUTH_URL=http://localhost:3000

COPISAURUS_CONFIG_PATH=/config/copisaurus.yaml
COPISAURUS_DATABASE_PATH=/data/copisaurus.db
COPISAURUS_REPOS_ROOT=/data/repos

# Microsoft Entra ID / Azure AD
AUTH_MICROSOFT_ENTRA_ID_ID=replace-with-entra-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-with-entra-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/replace-with-tenant-id/v2.0

# GitHub OAuth app
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret

# GitLab OAuth app
AUTH_GITLAB_ID=replace-with-gitlab-oauth-client-id
AUTH_GITLAB_SECRET=replace-with-gitlab-oauth-client-secret
AUTH_GITLAB_ISSUER=https://gitlab.example.com

# Generic OIDC provider. LDAP should be exposed through an OIDC bridge.
AUTH_OIDC_NAME=replace-with-provider-display-name
AUTH_OIDC_ID=replace-with-oidc-client-id
AUTH_OIDC_SECRET=replace-with-oidc-client-secret
AUTH_OIDC_ISSUER=https://oidc.example.com/realms/copisaurus

# Git repository sync service credentials
COPISAURUS_GITHUB_TOKEN=replace-with-github-service-token
COPISAURUS_GITLAB_TOKEN=replace-with-gitlab-service-token

# AI provider, shared with the legacy reference app and used by the Next.js app
# in later phases when AI endpoints are enabled.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-ai-api-key
AI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Legacy backend/frontend reference app
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Git provider - choose "gitlab" or "github"
# ---------------------------------------------------------------------------
GIT_PROVIDER=gitlab

# Full URL of the repository (used as the navbar link in the frontend)
# Note: do NOT include the token here - it's injected by the backend at runtime
GIT_REPO_URL=https://gitlab.example.com/group/repo

# Personal access token with read/write repo permissions
GIT_TOKEN=replace-with-legacy-git-token

# Branch used as the default target for commits
GIT_DEFAULT_BRANCH=master

# ---------------------------------------------------------------------------
# GitLab-specific (required when GIT_PROVIDER=gitlab)
# ---------------------------------------------------------------------------
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT_ID=42

# ---------------------------------------------------------------------------
# GitHub-specific (required when GIT_PROVIDER=github)
# ---------------------------------------------------------------------------
# GITHUB_OWNER=my-org
# GITHUB_REPO=ai-research

# Maximum number of tokens allowed in the LLM context window
MAX_CONTEXT_TOKENS=150000

# ---------------------------------------------------------------------------
# Internal paths (Docker default; change only if you know what you're doing)
# ---------------------------------------------------------------------------
DOCS_LOCAL_PATH=/app/docs-repo

# ---------------------------------------------------------------------------
# Frontend - backend URL injection
# ---------------------------------------------------------------------------
# Host port that the backend Docker container is mapped to (see docker-compose.yml).
# The Docusaurus dev server proxies /file, /chat, /edit, /commit to this URL.
BACKEND_URL=http://localhost:8021

# Used by Vitest / Vite when running frontend tests outside Docker
VITE_BACKEND_URL=http://localhost:8021
