# ---------------------------------------------------------------------------
# Git provider — choose "gitlab" or "github"
# ---------------------------------------------------------------------------
GIT_PROVIDER=gitlab

# Full URL of the repository (used as the navbar link in the frontend)
# Note: do NOT include the token here — it's injected by the backend at runtime
GIT_REPO_URL=https://gitlab.example.com/group/repo

# Personal access token with read/write repo permissions
GIT_TOKEN=glpat-xxxx

# Branch used as the default target for commits
GIT_DEFAULT_BRANCH=master

# ---------------------------------------------------------------------------
# GitLab-specific (required when GIT_PROVIDER=gitlab)
# ---------------------------------------------------------------------------
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT_ID=42

# ---------------------------------------------------------------------------
# GitHub-specific (required when GIT_PROVIDER=github)
# ---------------------------------------------------------------------------
# GITHUB_OWNER=my-org
# GITHUB_REPO=ai-research

# ---------------------------------------------------------------------------
# AI / LLM
# ---------------------------------------------------------------------------
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxx
AI_MODEL=gpt-4o

# Maximum number of tokens allowed in the LLM context window
MAX_CONTEXT_TOKENS=150000

# ---------------------------------------------------------------------------
# Internal paths (Docker default; change only if you know what you're doing)
# ---------------------------------------------------------------------------
DOCS_LOCAL_PATH=/app/docs-repo

# ---------------------------------------------------------------------------
# Frontend — backend URL injection
# ---------------------------------------------------------------------------
# Host port that the backend Docker container is mapped to (see docker-compose.yml).
# The Docusaurus dev server proxies /file, /chat, /edit, /commit to this URL.
BACKEND_URL=http://localhost:8021

# Used by Vitest / Vite when running frontend tests outside Docker
VITE_BACKEND_URL=http://localhost:8021
