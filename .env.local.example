# Local development defaults for `npm run dev`.
# These paths stay inside the repository so the app can run on a laptop without Docker volumes.

AUTH_SECRET=replace-with-local-random-secret
AUTH_URL=http://localhost:3000

LEGIT_CONFIG_PATH=./config/legit.local.yaml
LEGIT_DATABASE_PATH=./.codex-dev/legit.db
LEGIT_REPOS_ROOT=./.codex-dev/repos
LEGIT_DISABLE_SYNC_SCHEDULER=true

# Optional local admin bootstrap.
LEGIT_BOOTSTRAP_ADMIN_EMAILS=owner@example.com

# Optional OAuth / Git provider settings for real integration testing.
# AUTH_GITHUB_ID=replace-with-github-oauth-client-id
# AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret
# AUTH_GITLAB_ID=replace-with-gitlab-oauth-client-id
# AUTH_GITLAB_SECRET=replace-with-gitlab-oauth-client-secret
# AUTH_GITLAB_ISSUER=https://gitlab.example.com
# LEGIT_GITHUB_TOKEN=replace-with-github-service-token
# LEGIT_GITLAB_TOKEN=replace-with-gitlab-service-token
