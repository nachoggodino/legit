# Production / container deployment defaults.
# Mount writable volumes at `/data` and `/config`.

AUTH_SECRET=replace-with-random-auth-secret
AUTH_URL=http://localhost:3000

LEGIT_CONFIG_PATH=/config/legit.yaml
LEGIT_DATABASE_PATH=/data/legit.db
LEGIT_REPOS_ROOT=/data/repos

# Optional explicit one-time bootstrap list when YAML admins are not configured.
LEGIT_BOOTSTRAP_ADMIN_EMAILS=owner@example.com

# Microsoft Entra ID / Azure AD
AUTH_MICROSOFT_ENTRA_ID_ID=replace-with-entra-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=replace-with-entra-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/replace-with-tenant-id/v2.0

# GitHub OAuth app
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret

# GitLab OAuth app. For gitlab.com, use https://gitlab.com as issuer.
AUTH_GITLAB_ID=replace-with-gitlab-oauth-client-id
AUTH_GITLAB_SECRET=replace-with-gitlab-oauth-client-secret
AUTH_GITLAB_ISSUER=https://gitlab.example.com

# Generic OIDC provider. LDAP should be exposed through an OIDC bridge.
AUTH_OIDC_NAME=replace-with-provider-display-name
AUTH_OIDC_ID=replace-with-oidc-client-id
AUTH_OIDC_SECRET=replace-with-oidc-client-secret
AUTH_OIDC_ISSUER=https://oidc.example.com/realms/legit

# Git repository sync service credentials
LEGIT_GITHUB_TOKEN=replace-with-github-service-token
LEGIT_GITLAB_TOKEN=replace-with-gitlab-service-token

# AI provider
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-ai-api-key
AI_MODEL=gpt-4o
