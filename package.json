{
  "name": "legit",
  "version": "1.0.0",
  "description": "AI-powered documentation wiki backed by Git",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "node scripts/dev-mock-doc.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:next": "next dev",
    "dev:mock-doc": "node scripts/dev-mock-doc.mjs",
    "build": "LEGIT_BUILD_PHASE=1 LEGIT_DATABASE_PATH=/tmp/legit-build.db next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run",
    "test:unit": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run",
    "test:watch": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest",
    "test:coverage": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run --coverage",
    "test:e2e": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp playwright test",
    "test:playwright": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp playwright test",
    "test:all": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test:coverage && corepack pnpm test:e2e",
    "verify": "corepack pnpm test:all",
    "typecheck": "tsc --noEmit",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "docker:restart": "docker compose restart app",
    "docker:logs": "docker compose logs -f app",
    "docker:status": "docker compose ps",
    "docker:build": "docker compose build",
    "docker:clean": "docker compose down --volumes --remove-orphans",
    "docker:shell": "docker compose exec app /bin/sh"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.45.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp",
      "unrs-resolver"
    ]
  }
}
