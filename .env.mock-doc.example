AUTH_SECRET=replace-with-local-random-secret
AUTH_URL=http://localhost:3000

LEGIT_CONFIG_PATH=./config/legit.mock-doc.yaml
LEGIT_DATABASE_PATH=./.codex-dev/legit.db
LEGIT_REPOS_ROOT=./.codex-dev/repos

# GitHub OAuth app for signing in with your GitHub account.
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret

# Git service token for cloning/syncing/pushing nachoggodino/mock-doc.
LEGIT_GITHUB_TOKEN=replace-with-github-service-token

# Optional but recommended so your GitHub account becomes admin after sign-in.
LEGIT_BOOTSTRAP_ADMIN_EMAILS=you@example.com
